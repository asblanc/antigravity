# Firebase Configuration — IVOIRE BUSINESS CLUB (IBC)
# Copy this file to .env and fill in your Firebase project values
# Get these from: Firebase Console → Project Settings → General → Your apps → Web App

VITE_FIREBASE_API_KEY=REPLACE_ME
VITE_FIREBASE_AUTH_DOMAIN=ivoire-business-club.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ivoire-business-club
VITE_FIREBASE_STORAGE_BUCKET=ivoire-business-club.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME
VITE_FIREBASE_APP_ID=REPLACE_ME
